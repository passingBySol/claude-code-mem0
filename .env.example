# mem0 Configuration (Project Override)
# Copy this file to your project root as .env to override global settings
# Global config should go in ~/.claude/settings.json under "env"
# Get your API key from https://app.mem0.ai

MEM0_API_KEY=your-api-key-here
MEM0_USER_ID=claude-code-user

# Optional settings
MEM0_TOP_K=5
MEM0_THRESHOLD=0.3
MEM0_SAVE_MESSAGES=10
MEM0_AUTO_SAVE=true
