# mem0 Configuration
# Copy this file to ~/.claude/.env for global configuration
# Or to your project root as .env for project-specific overrides
# Get your API key from https://app.mem0.ai

MEM0_API_KEY=your-api-key-here
MEM0_USER_ID=claude-code-user

# Optional settings
MEM0_TOP_K=5
MEM0_THRESHOLD=0.3
MEM0_SAVE_MESSAGES=10
MEM0_AUTO_SAVE=true
